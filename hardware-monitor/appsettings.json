{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "HardwareMonitor": {
    "DatabasePath": "hardware-monitor.db",
    "PersistIntervalSeconds": 5,
    "RetentionDays": 7,
    "Drives": ["C:", "D:"],
    "CpuWarnThreshold": 75,
    "CpuCritThreshold": 90,
    "GpuWarnThreshold": 70,
    "GpuCritThreshold": 85,
    "WebUrl": "http://localhost:5005"
  }
}
